{
  "title": "Agent, skill and position changes — apply plan",
  "date": "2026-10-17",
  "branch": "agent-skill-audit",
  "agentIds": "Agents are listed by the first 8 characters of their id (from the live inventory). Resolve the full id with GET /api/companies/{companyId}/agents before applying.",
  "skip": [
    "621d5687 Assistant (quick agent, excluded by Filip)",
    "3aacdb86 Secretary (quick agent, excluded by Filip)"
  ],
  "prerequisites": [
    "Deploy branch agent-skill-audit first. Steps marked needsDeploy=true use skills, routes or model ids that only exist after the deploy.",
    "The Brag position in Durkan Agency converts itself on the first server start after the deploy (startup task convertBragPositionsToSkill): it becomes the Content & Video Producer position, any agent in it moves over, and the Brag position is removed. No manual step needed; step 'verify-brag' checks it.",
    "Model ids claude-*-5-5 are accepted by PATCH /api/agents/:id before the deploy too (the agent PATCH does not validate against the model list), but the model picker in the UI only lists them after the deploy. Applying model changes after the deploy is cleaner."
  ],
  "endpoints": {
    "enableJobs": {
      "method": "PUT",
      "path": "/api/companies/{companyId}/job-settings/jobs-enabled",
      "body": {
        "enabled": true
      },
      "auth": "board (owner or admin)"
    },
    "installCatalogSkill": {
      "method": "POST",
      "path": "/api/companies/{companyId}/skills/install-catalog",
      "body": {
        "catalogSkillId": "<id>"
      },
      "auth": "board",
      "note": "Idempotent: returns action 'unchanged' when already installed. The new skills only exist after branch agent-skill-audit is deployed."
    },
    "addPositionFromCatalogue": {
      "method": "POST",
      "path": "/api/companies/{companyId}/positions/catalogue/{templateKey}",
      "body": {},
      "auth": "board",
      "note": "New in this branch (alias of /agent-roles/catalogue). Creates the position + its jobs and installs the catalogue skills it needs; idempotent (an existing position is left as is, only missing jobs are linked). Response lists warnings for skills that could not be installed."
    },
    "listCatalogue": {
      "method": "GET",
      "path": "/api/companies/{companyId}/positions/catalogue",
      "auth": "board"
    },
    "patchAgent": {
      "method": "PATCH",
      "path": "/api/agents/{agentId}",
      "body": {
        "adapterConfig": {
          "model": "<id>",
          "effort": "<level>"
        }
      },
      "auth": "board",
      "note": "adapterConfig is MERGED (replaceAdapterConfig not set), so only model/effort change."
    },
    "readAgentSkills": {
      "method": "GET",
      "path": "/api/agents/{agentId}/skills",
      "auth": "board",
      "note": "Read desiredSkills before syncing."
    },
    "syncAgentSkills": {
      "method": "POST",
      "path": "/api/agents/{agentId}/skills/sync",
      "body": {
        "desiredSkills": [
          "<key>",
          "..."
        ]
      },
      "auth": "board",
      "note": "REPLACES the whole list. Send union(current desiredSkills, addSkillKeys) minus removeSkillKeys. Agents cannot call this on themselves."
    },
    "assignPosition": {
      "method": "POST",
      "path": "/api/agents/{agentId}/role",
      "body": {
        "roleId": "<positionId>"
      },
      "auth": "board",
      "note": "Not used in this plan: assigning a position overwrites the agent's bootstrapPromptTemplate with the position's instructions."
    },
    "patchPosition": {
      "method": "PATCH",
      "path": "/api/positions/{positionId}",
      "body": {
        "skillKeys": [
          "..."
        ]
      },
      "auth": "board"
    }
  },
